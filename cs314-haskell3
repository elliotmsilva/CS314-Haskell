-- 2. Check whether the given tree is a binary search tree. That is, for a
-- non-Tip tree Bin l a r, all elements in l are less than a, all elements in
-- r are greater than a, and both l and r are binary search trees.
--
-- Challenge: can you write this function such that each Bin Bin is visited
-- at most once?

isBST :: Ord a => Tree a -> Bool
isBST Tip = True
isBST (Bin l a r) = all (< a) l && all (> a) r && isBST l && isBST r

--check left subtree (Bin _ b _) is valid only when b<a
--check right subtree (Bin _ b _) is valid only when b>a

