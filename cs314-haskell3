-- 3. Write a function that extracts the minimum entry from a priority queue.
--
-- We define a priority queue as a binary tree in which each path from the
-- root to a leaf is non-decreasing.

isPQ :: Ord a => Tree a -> Bool
isPQ Tip = True
isPQ (Bin l a r) = check a l && check a r
    where
    check a Tip = True
    check a (Bin l b r) = a <= b && check b l && check b r

-- getMin t should return Nothing if the tree is Tip, and Just (a, t')
