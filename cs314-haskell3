-- 1. Insert an element into a binary search tree. That is, replace
-- a Tip somewhere in the tree with Bin Tip a Tip, where a is the value
-- being inserted.
--
-- You may assume that the input tree has the binary search tree property.

insertBST :: Ord a => a -> Tree a -> Tree a
insertBST n Tip = Bin Tip n Tip
insertBST n (Bin l a r)
    | n < a     = Bin (insertBST n l) a r
    | n > a     = Bin l a (insertBST n r)
    | otherwise = Bin l a r

-- n<a, insert in left subtree
-- n>a, insert in right subtree
-- n==a, no dupes > skip insertion (assuming this is no dupe???)

