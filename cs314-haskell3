-- You may assume that the list has exactly as many elements as there are spots
-- in the tree.
--
-- for all trees t, labelTree (map (const ()) t) (toList t) == t


labelTree :: Tree () -> [a] -> Tree a
labelTree Tip _ = Tip
labelTree tree es = fst (inOrder tree es)
  
--helper method to traverse and replace
inOrder :: Tree () -> [a] -> (Tree a, [a])
inOrder (Tip) (es) = (Tip, es)                    --base case, tip do nothing w list of es
inOrder (Bin left () right) (es) = (Bin newleft e newright, esright)
    where
        (newleft, e : esleft) = inOrder left es
        (newright, esright) = inOrder right esleft
